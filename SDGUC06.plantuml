@startuml SDGUC06
title UC06 - Recuperar Acesso da Escola

actor Administrador

boundary "Tela Escolas Bloqueadas" as Tela
control "EscolaController" as Controller
control "EscolaService" as Service
database "PostgreSQL" as Banco

Administrador -> Tela : Seleciona escola

Tela -> Controller : recuperarAcesso(id)

Controller -> Service : validarSenha()

alt Senha inválida

Service --> Controller : Erro
Controller --> Tela : Informar erro

else Senha válida

Service -> Banco : Verificar status

alt Escola já ativa

Banco --> Service : Ativa
Service --> Controller : Informar situação
Controller --> Tela : Exibir mensagem

else Escola bloqueada

Banco --> Service : Bloqueada
Service -> Banco : Atualizar status
Banco --> Service : OK
Service --> Controller : Recuperação realizada
Controller --> Tela : Exibir sucesso

end

end

@enduml